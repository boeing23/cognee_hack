# NopeList — copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env
# Required vars are uncommented (fill them); optional ones are commented out.
# Demo insurance: set NOPELIST_DRY_RUN=1 to run fully offline from data/fixtures/.

# =============================================================================
# General
# =============================================================================
# 1 = fixtures only, zero network (brain/scraper/discover/agent all honor it).
NOPELIST_DRY_RUN=0
# Path to the blacklist JSON (default data/blacklist.json).
#NOPELIST_BLACKLIST=data/blacklist.json
# Option A event list; agent.py sets this from --events (default data/events.txt).
#NOPELIST_EVENTS_FILE=data/events.txt

# =============================================================================
# ---- Model provider: Meta Model API (Muse Spark) — PRIMARY ----
# Drives the AWS Strands agent loop (src/agent.py) and, via the Cognee block below, the
# blacklist brain. OpenAI-compatible chat completions at https://api.meta.ai/v1.
# Get a key: https://dev.meta.ai  ·  Docs: https://dev.meta.ai/docs/protocols/chat-completions
# Selection order in agent.py: MODEL_API_KEY -> ANTHROPIC_API_KEY -> AWS creds (Bedrock).
# =============================================================================
MODEL_API_KEY=
# Base URL of the OpenAI-compatible endpoint (default shown).
#META_API_BASE_URL=https://api.meta.ai/v1
# Model id for the Strands agent (muse-spark-1.3 primary, muse-spark-1.1 also available).
STRANDS_MODEL_ID=muse-spark-1.3
# Force a provider instead of auto-detecting from which keys are set: meta | anthropic | bedrock.
#NOPELIST_MODEL_PROVIDER=meta

# =============================================================================
# Cognee — the blacklist brain (src/brain.py)
# Docs: https://docs.cognee.ai/setup-configuration/llm-providers
# =============================================================================
# Cognee routes LLM calls through LiteLLM. 'custom' = any OpenAI-compatible endpoint;
# the model id MUST carry the 'openai/' prefix so LiteLLM speaks chat-completions to it.
LLM_PROVIDER=custom
# The Meta Model API base URL (same as META_API_BASE_URL).
LLM_ENDPOINT=https://api.meta.ai/v1
# Same value as MODEL_API_KEY (Cognee reads THIS name).
LLM_API_KEY=
# 'openai/' + the Muse Spark model id.
LLM_MODEL=openai/muse-spark-1.3
# --- Anthropic alternative (fallback; pairs with ANTHROPIC_API_KEY below) ---
#LLM_PROVIDER=anthropic
#LLM_API_KEY=sk-ant-...
#LLM_MODEL=anthropic/claude-sonnet-5
# Local CPU embeddings (ships inside cognee). Without these Cognee defaults to OpenAI
# embeddings and raises ProviderConfigMismatchError.
EMBEDDING_PROVIDER=fastembed
# Downloaded automatically on first run (~90MB). Pre-warm before the demo
# (the Dockerfile bakes it into the image).
EMBEDDING_MODEL=all-MiniLM-L6-v2
# 384 for all-MiniLM-L6-v2.
EMBEDDING_DIMENSIONS=384
# --- optional ---
# Cognee Cloud instead of local embedded Cognee ($50 credit: promo PERSONALBRAIN0926 at
# https://platform.cognee.ai/billing). Set BOTH to switch; brain.py then calls cognee.serve().
#COGNEE_SERVICE_URL=https://your-tenant.aws.cognee.ai
#COGNEE_API_KEY=cog_...
# Dataset name holding the blacklist (default nopelist_blacklist).
#COGNEE_DATASET=nopelist_blacklist
# 1 = prune Cognee data + system state before ingesting (clean re-seed between rehearsals).
#NOPELIST_RESET_BRAIN=0

# =============================================================================
# Bright Data — Browser API (Scraping Browser) for live Luma guest lists (src/scraper.py)
# Sign up with promo cognee50 for $50 credit: https://brightdata.com?promo=cognee50&hs_signup=1
# Dashboard -> Proxies & Scraping -> add/open a zone of type 'Browser API' -> Overview tab
# shows Username + Password: https://brightdata.com/cp/zones
# Not needed when NOPELIST_DRY_RUN=1.
# =============================================================================
BRIGHTDATA_BROWSER_USER=
BRIGHTDATA_BROWSER_PASS=
# --- optional ---
# Single 'USER:PASS' string; overrides the two vars above (matches Bright Data's AUTH examples).
#BRIGHTDATA_BROWSER_AUTH=brd-customer-hl_a1b2c3d4-zone-nopelist:x9y8z7w6v5u4
# Full CDP endpoint override (copy the wss:// URL from the zone Overview tab).
#BRIGHTDATA_BROWSER_WSS=wss://USER:PASS@brd.superproxy.io:9222
# Only for the optional Bright Data MCP server container in docker-compose.yml
# (Dashboard -> Account settings -> API tokens).
#BRIGHTDATA_API_TOKEN=

# =============================================================================
# ---- Luma (MCP, OAuth — no API key) ----
# The official Luma MCP server (https://mcp.luma.com, streamable HTTP) authenticates
# with OAuth Client ID Metadata Documents: the client_id IS the URL of a hosted JSON
# doc (docs/luma-client.json, served by GitHub Pages). No API keys, no dynamic client
# registration, nothing to copy from a dashboard. One-time login (opens a browser):
#   python -m src.luma_auth          # saves tokens to LUMA_TOKEN_FILE, refreshes silently
# Gives: auto-discovery of your registered events (list_events) + structured guest
# lists for events you HOST (list_guests is host-only). Attended events are still
# scraped via Bright Data. Not needed when NOPELIST_DRY_RUN=1.
# =============================================================================
LUMA_CLIENT_METADATA_URL=https://boeing23.github.io/cognee_hack/luma-client.json
# --- optional ---
# Where OAuth tokens are persisted (default ~/.nopelist/luma_tokens.json). Never commit it.
#LUMA_TOKEN_FILE=~/.nopelist/luma_tokens.json

# =============================================================================
# AWS Strands — agent harness (src/agent.py)
# Model comes from the provider block at the top (Meta primary) or a fallback below.
# =============================================================================
# max_tokens passed to the model (default 2048).
#STRANDS_MAX_TOKENS=2048

# =============================================================================
# ---- Fallback providers (optional) ----
# Used only when MODEL_API_KEY is unset (or NOPELIST_MODEL_PROVIDER forces one).
# If you switch, also change STRANDS_MODEL_ID above (or unset it for the provider default:
# claude-opus-5 on Anthropic | us.anthropic.claude-sonnet-4-5-20250929-v1:0 on Bedrock)
# and the Cognee LLM_* block to the Anthropic alternative.
# =============================================================================
# --- Anthropic — https://console.anthropic.com/settings/keys ---
# Must be a Console API key, not a Claude subscription OAuth token.
#ANTHROPIC_API_KEY=
# --- Bedrock ($25 AWS credit) ---
# IAM console -> user -> Security credentials -> Create access key. Needs
# bedrock:InvokeModelWithResponseStream + model access enabled in AWS_REGION.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_REGION=us-west-2
